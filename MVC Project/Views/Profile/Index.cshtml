@model MVC_Project.Models.ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<div class="profile-card">
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <img src="@Model.ImagePath" alt="Profile picture of @Model.FullName" class="avatar-img" />
    }
    else
    {
        <div class="avatar">@Model.FullName.Substring(0, 1)</div>
    }
    <h1>@Model.FullName</h1>
    <p class="subtitle">@Model.Course</p>
    <p class="subtitle">@Model.School</p>

    <hr />

    <h4>About Me</h4>
    <p>@Model.Bio</p>

    </div>
</div>