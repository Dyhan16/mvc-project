@model MVC_Project.Models.ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<div class="profile-card">
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <div class="pfp-wrap">
            <img src="@Model.ImagePath" alt="Profile picture of @Model.FullName" class="avatar-img" />
        </div>
    }
    else
    {
        <div class="avatar">@Model.FullName.Substring(0, 1)</div>
    }
    <h1>@Model.FullName</h1>
    <p class="subtitle">@Model.Course</p>
    <p class="subtitle">@Model.School</p>

    <hr />

    <h4>About Me</h4>
    <p class="bio">@Model.Bio</p>
    
    <h4>Skills</h4>
    <div class="skill-list">
        @foreach (var skill in Model.Skills)
        {
            <span class="skill-badge">@skill</span>
        }
    </div>
</div>